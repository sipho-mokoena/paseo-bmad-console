# =============================================================================
# Paseo BMAD Console: environment variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Or use the setup script to generate REVALIDATE_SECRET and a dev DATABASE_URL:
#   bash scripts/setup.sh
#
# Never commit .env or .env.local to version control.
#
# SECURITY: the app has NO authentication. Anyone who can reach the port can
# add and remove projects and, with ENABLE_LOCAL_FS=true, read local BMAD
# folders. Run it on localhost or a private network only.
# =============================================================================

# --- Database ---
# PostgreSQL connection string. Replace <your-db-password> with the
# value you set as POSTGRES_PASSWORD in docker-compose.yml (or in your
# own Postgres instance). The setup script (scripts/setup.sh) writes a
# working dev DATABASE_URL automatically.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://bmad:<your-db-password>@localhost:7433/bmad_dashboard

# --- Local Filesystem (self-hosted only) ---
# Enable local folder imports. Only works when the Next.js server runs on the
# same machine as the files (self-hosted deployment).
# SELF-HOSTED ONLY: the server reads folders from its own disk and the app has
# no login. Never enable on a shared or public deployment.
# ENABLE_LOCAL_FS=true

# --- Dev server access (development only) ---
# Extra hostnames/IPs allowed to reach `next dev` (e.g. a Tailscale name or LAN IP).
# Comma-separated. Empty by default. Also start the server with: pnpm dev -H 0.0.0.0
# (binding beyond 127.0.0.1 exposes the unauthenticated app to that network)
# ALLOWED_DEV_ORIGINS=my-laptop.tailnet-name.ts.net,100.64.0.10

# --- GitHub Personal Access Token (optional) ---
# GitHub projects are added by owner/name; there is no GitHub login.
# Without a PAT the GitHub API allows 60 requests/hour and only public
# repositories can be read. With a PAT you get 5,000 requests/hour and can read
# private repositories. Restart the server after changing it.
#
# Create one at: https://github.com/settings/tokens -> "Generate new token (classic)"
# Required scopes:
#   - "public_repo" for public repositories only
#   - "repo"        for private repositories
GITHUB_PAT=

# --- Cache Revalidation ---
# Optional. Secret for POST /api/revalidate (header x-revalidate-secret).
# Leave empty to disable the endpoint: it then answers 503.
# Generate with:  openssl rand -hex 32
REVALIDATE_SECRET=
